GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────
# OpenAI (opt-in, switched at runtime per thread via the 'set_provider'
# socket event — see client-examples/test.html). There is no OPENAI_API_KEY
# here on purpose: OpenAI always requires a client-supplied key, only the
# model name is configured server-side.
# ─────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=

REDIS_URL=

# ─────────────────────────────────────────────
# Langfuse Observability (self-hosted)
# Sau khi chạy docker-compose.langfuse.yml → lấy keys từ UI
# ─────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ─────────────────────────────────────────────
# Message Trimming (optional)
# Giới hạn số tokens trong context để tránh phình to
# Default: 4000 tokens (~15-20 messages)
# ─────────────────────────────────────────────
MAX_CONTEXT_TOKENS=4000

# ─────────────────────────────────────────────
# Socket Server Configuration
# ─────────────────────────────────────────────
SOCKET_HOST=0.0.0.0
SOCKET_PORT=5000
SOCKET_DEBUG=False
CORS_ORIGINS=*

# Rate Limiting (requests per time window)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per minute
RATE_LIMIT_CHAT=20 per minute

# API Key for protected endpoints (health, stats) — service-to-service secret
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here

# JWT for end-user clients connecting to the Socket gateway (POST /auth/token
# issues these — see socket_server.py). Different secret than API_KEY above.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-jwt-key-here
JWT_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/socket_server.log

# ─────────────────────────────────────────────
# AI Agent API Server (FastAPI, standalone service)
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_FILE=logs/api_server.log

# Reachable URL of the AI Agent API server (used by socket_server.py to call it)
# Use 127.0.0.1, not "localhost" (eventlet's DNS resolver can hang on Windows)
AI_SERVICE_URL=http://127.0.0.1:8000
