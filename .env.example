GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=

REDIS_URL=

# ─────────────────────────────────────────────
# Langfuse Observability (self-hosted)
# Sau khi chạy docker-compose.langfuse.yml → lấy keys từ UI
# ─────────────────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ─────────────────────────────────────────────
# Message Trimming (optional)
# Giới hạn số tokens trong context để tránh phình to
# Default: 4000 tokens (~15-20 messages)
# ─────────────────────────────────────────────
MAX_CONTEXT_TOKENS=4000

# ─────────────────────────────────────────────
# Socket Server Configuration
# ─────────────────────────────────────────────
SOCKET_HOST=0.0.0.0
SOCKET_PORT=5000
SOCKET_DEBUG=False
CORS_ORIGINS=*

# Rate Limiting (requests per time window)
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per minute
RATE_LIMIT_CHAT=20 per minute

# API Key for protected endpoints (health, stats)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/socket_server.log
